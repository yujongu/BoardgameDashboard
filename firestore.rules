rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Returns true if the caller is in the target user's friends subcollection.
    // Both sides of a friendship are always written symmetrically, so this is
    // equivalent to checking the reverse direction.
    function isFriendOf(userId) {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)/friends/$(userId));
    }

    // board games catalog — any authenticated user can read; writes are admin-only
    match /boardGames/{gameId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // plays — client read only if caller is a participant; all writes via Cloud Functions (Admin SDK bypasses rules)
    match /plays/{playId} {
      allow read:  if request.auth != null
                   && request.auth.uid in resource.data.participantIds;
      allow write: if false;

      match /participants/{participantId} {
        allow read: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/plays/$(playId)).data.participantIds;
        allow write: if false;
      }
    }

    // shared cooperative campaigns (table-scoped) — any member can read and make
    // manual edits (roster/stage tweaks); the creator must include themselves as
    // a member. Stage advances from co-op play logging are written by the
    // createPlay Cloud Function via the Admin SDK, which bypasses these rules.
    match /campaigns/{campaignId} {
      allow read: if request.auth != null
                  && request.auth.uid in resource.data.memberIds;
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.memberIds
                    && request.auth.uid == request.resource.data.createdBy;
      // A table's seats are fixed at creation: members may correct the board,
      // but nobody may add or remove a participant afterwards.
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.memberIds
                    && request.resource.data.memberIds == resource.data.memberIds
                    && request.resource.data.participants == resource.data.participants;
      allow delete: if request.auth != null
                    && request.auth.uid in resource.data.memberIds;
    }

    // user search index — any authenticated user can read (used for participant search);
    // owner can write their own doc (name/photoUrl updates from client)
    match /userSearch/{userId} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // user profile document — owner full access; friends can read name/photoUrl
    match /users/{userId} {
      allow read:  if request.auth != null
                   && (request.auth.uid == userId || isFriendOf(userId));
      allow write: if request.auth != null && request.auth.uid == userId;

      // friends subcollection — owner read only (direct client read, no Cloud Function needed)
      match /friends/{friendId} {
        allow read:  if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      // library subcollection — owner read only; writes via Cloud Functions
      match /library/{gameId} {
        allow read:  if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      // campaign record sheets (e.g. The Crew) — owner full access, written from client
      match /campaigns/{gameId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // aggregated stats — owner or friend can read
    match /stats/{userId} {
      allow read:  if request.auth != null
                   && (request.auth.uid == userId || isFriendOf(userId));
      allow write: if false;

      match /gameStats/{gameId} {
        allow read:  if request.auth != null
                     && (request.auth.uid == userId || isFriendOf(userId));
        allow write: if false;
      }
    }

  }
}
